// ─────────────────────────────────────────────────────────────
// Add this model to your existing prisma/schema.prisma.
// If you already have a `User` model, add the relation line
// marked below and run: npx prisma migrate dev --name add_connected_accounts
// ─────────────────────────────────────────────────────────────

enum OAuthProvider {
  INSTAGRAM
  TIKTOK
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  EXPIRED
}

model ConnectedAccount {
  id String @id @default(cuid())

  userId String
  // If you have a User model, uncomment and adjust the relation:
  // user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider          OAuthProvider
  providerAccountId String // the id TikTok/Instagram assigns to the connected account
  username          String?
  displayName       String?
  avatarUrl         String?

  // Tokens are encrypted (AES-256-GCM) before they ever reach Prisma —
  // see lib/oauth/encryption.ts. Never store or log raw tokens.
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  scopes                String[] @default([])

  status       ConnectionStatus @default(CONNECTED)
  lastErrorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One row per (user, provider, external account) — supports multiple
  // accounts per provider per user (e.g. two TikTok accounts) while
  // preventing duplicate rows for the same external account.
  @@unique([userId, provider, providerAccountId])
  @@index([userId])
  @@index([provider, providerAccountId])
}
