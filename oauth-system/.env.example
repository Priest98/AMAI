# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://marketing-os-eight-virid.vercel.app

# ── Security ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_ENCRYPTION_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_STATE_SECRET=

# ── Instagram (Meta / Facebook Login for Business) ──────────
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# Optional — defaults to {NEXT_PUBLIC_APP_URL}/api/oauth/instagram/callback
INSTAGRAM_REDIRECT_URI=
META_GRAPH_API_VERSION=v21.0
INSTAGRAM_SCOPES=instagram_basic,instagram_manage_comments,instagram_manage_insights,pages_show_list,business_management

# ── TikTok ───────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Optional — defaults to {NEXT_PUBLIC_APP_URL}/api/oauth/tiktok/callback
TIKTOK_REDIRECT_URI=
TIKTOK_SCOPES=user.info.basic,video.publish,video.upload

# ── Database (you likely already have this) ────────────────
DATABASE_URL=
