{
  "name": "marketing-os",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "5.22.0",
    "@vercel/blob": "^0.27.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express": "^4.19.2",
    "googleapis": "^140.0.0",
    "nodemailer": "^6.9.16",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "5.22.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/express": "4.17.21",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^6.4.17",
    "@vercel/node": "^5.1.10",
    "next": "^15.1.0"
  },
  "overrides": {
    "prisma": "5.22.0",
    "@prisma/client": "5.22.0",
    "typescript": "5.1.3",
    "@types/express": "4.17.21"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspace=@marketing-os/shared-types --if-present && npm run build --workspaces --if-present",
    "vercel-build": "npm run build --workspace=@marketing-os/shared-types && npm run build --workspace=web && npm run build --workspace=@marketing-os/api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "node --test tests/production-regressions.test.cjs && npm run test --workspaces --if-present"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4.0.0",
    "lightningcss-linux-x64-gnu": "^1.29.0"
  }
}
