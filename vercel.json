{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "apps/web/.next",
  "crons": [
    {
      "path": "/api/cron/publish-due",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/sync-drive",
      "schedule": "0 13 * * *"
    }
  ]
}
