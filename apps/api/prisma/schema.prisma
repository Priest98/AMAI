generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Schema-changing commands (db push, migrate deploy) need a direct,
  // non-pooled connection — Supabase's transaction-mode pgbouncer pooler
  // (the one DATABASE_URL points at, port 6543) doesn't support the
  // session-level operations these commands issue and just hangs instead
  // of erroring. DIRECT_URL should be the same connection on port 5432
  // (Supabase's "Session" pooler mode, or the true direct db.<ref> host).
  directUrl = env("DIRECT_URL")
}

model User {
  id                         String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  email                      String               @unique
  passwordHash               String
  fullName                   String?
  avatar                     String?
  role                       Role                 @default(OWNER)
  emailVerified              Boolean              @default(false)
  emailVerifiedAt            DateTime?            @db.Timestamptz(6)
  verificationToken          String?              @unique
  verificationTokenExpiresAt DateTime?            @db.Timestamptz(6)
  passwordResetToken         String?              @unique
  passwordResetExpiresAt     DateTime?            @db.Timestamptz(6)
  lastLogin                  DateTime?            @db.Timestamptz(6)
  onboardingCompleted        Boolean              @default(false)
  createdAt                  DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  memberships                OrganizationMember[]
}

model Organization {
  id        String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  name      String
  slug      String               @unique
  ownerId   String
  createdAt DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  brands    Brand[]
  members   OrganizationMember[]
}

model OrganizationMember {
  id             String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId         String
  organizationId String
  role           Role         @default(VIEWER)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, organizationId])
  @@index([userId], map: "idx_org_member_user")
}

model Brand {
  id                  String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  name                String
  organizationId      String
  logo                String?
  colors              String?
  timezone            String                @default("UTC")
  industry            String?
  createdAt           DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  aiUsageLogs         AiUsageLog[]
  amaiEngineConfig    AmaiEngineConfig?
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  growthSettings      GrowthSettings?
  mediaAssets         MediaAsset[]
  mediaFolders        MediaFolder[]
  PendingCommentReply PendingCommentReply[]
  posts               Post[]
  socialAccounts      SocialAccount[]
  engineEvents        EngineEvent[]
}

model GrowthSettings {
  id                String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  brandId           String   @unique
  autoReplyComments Boolean  @default(false)
  commentTone       String   @default("friendly")
  optimizeHashtags  Boolean  @default(true)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  brand             Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model SocialAccount {
  id                String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  brandId           String
  platform          Platform
  platformAccountId String
  accessToken       String
  refreshToken      String?
  tokenExpiresAt    DateTime?        @db.Timestamptz(6)
  metadata          String?
  status            ConnectionStatus @default(CONNECTED)
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  postTargets       PostTarget[]
  brand             Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([platform, platformAccountId])
  @@index([brandId], map: "idx_social_account_brand")
}

model MediaFolder {
  id        String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  brandId   String
  name      String
  parentId  String?
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  assets    MediaAsset[]
  brand     Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parent    MediaFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  MediaFolder[] @relation("FolderHierarchy")
}

enum MediaStatus {
  PENDING // just uploaded, AMAI Engine has not finished analysing/preparing it yet
  PROCESSING // AMAI Engine is analysing content, generating caption/hashtags/best time
  READY // AMAI Engine finished preparing a post from this asset
  SCHEDULED
  PUBLISHED
  FAILED
}

model MediaAsset {
  id               String      @id @default(cuid())
  userId           String?
  brandId          String?
  folderId         String?
  batchId          String?
  batchName        String?
  relativePath     String?
  filename         String
  mimeType         String
  sizeBytes        Int         @default(0)
  blobUrl          String?
  source           ContentSource @default(DIRECT_UPLOAD)
  status           MediaStatus @default(PENDING)
  linkedPostId     String?
  platform         String?
  providerPostId   String?
  publishedAt      DateTime?
  lastErrorMessage String?
  createdAt        DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime    @default(now()) @updatedAt @db.Timestamptz(6)

  brand     Brand?       @relation(fields: [brandId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  folder    MediaFolder? @relation(fields: [folderId], references: [id], onUpdate: NoAction)
  postMedia PostMedia[]

  @@index([userId])
  @@index([userId, batchId])
  @@index([status])
  @@index([brandId, folderId, createdAt], map: "idx_media_brand_folder_created")
  @@index([brandId, status], map: "idx_media_brand_status")
}

model Post {
  id               String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  brandId          String
  caption          String
  hashtags         String[]     @default([])
  ctaText          String?
  source           ContentSource @default(MANUAL)
  status           PostStatus   @default(DRAFT)
  scheduledAt      DateTime?    @db.Timestamptz(6)
  optimalScore     Int?
  peakTimeDetected Boolean      @default(false)
  approvedAt       DateTime?    @db.Timestamptz(6)
  rejectedAt       DateTime?    @db.Timestamptz(6)
  publishedAt      DateTime?    @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  brand            Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  media            PostMedia[]
  targets          PostTarget[]

  @@index([brandId, status], map: "idx_post_brand_status")
  @@index([scheduledAt], map: "idx_post_scheduled")
}

model PostTarget {
  id                       String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  postId                   String
  socialAccountId          String
  platform                 Platform
  platformSpecificMetadata String?
  status                   TargetStatus    @default(PENDING)
  post                     Post            @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  socialAccount            SocialAccount   @relation(fields: [socialAccountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  publishingLogs           PublishingLog[]

  @@unique([postId, socialAccountId])
}

model PostMedia {
  postId  String
  assetId String
  asset   MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  post    Post       @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([postId, assetId])
}

model AiUsageLog {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  brandId    String
  userId     String
  prompt     String
  completion String
  tokensUsed Int
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model PublishingLog {
  id           String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  postTargetId String
  status       TargetStatus
  errorMessage String?
  apiResponse  String?
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  postTarget   PostTarget   @relation(fields: [postTargetId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// The AMAI Engine's per-brand configuration: whether it is Active/Paused,
/// which Approval Mode governs publishing, and (optionally) the connected
/// Google Drive sync folder. This replaces the old AutoPilotConfig model.
model AmaiEngineConfig {
  id                 String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  brandId            String         @unique
  state              EngineState    @default(ACTIVE)
  approvalMode       ApprovalMode   @default(MANUAL)
  defaultTone        String         @default("friendly")
  googleRefreshToken String?
  driveFolderId      String?
  webhookToken       String?        @unique
  createdAt          DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  brand              Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  syncLogs           DriveSyncLog[]
}

model DriveSyncLog {
  id           String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  configId     String
  googleFileId String
  status       TargetStatus
  postId       String?
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  config       AmaiEngineConfig @relation(fields: [configId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([configId, googleFileId])
}

model PendingCommentReply {
  id                  String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  brandId             String
  platform            Platform
  platformAccountId   String
  originalPostId      String
  originalCommentId   String
  originalCommentText String
  aiGeneratedReply    String
  status              ReplyStatus @default(PENDING)
  createdAt           DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  brand               Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([brandId, status], map: "idx_pending_reply_brand_status")
}

/// Append-only audit trail of everything the AMAI Engine does. Powers the
/// real-time activity feed / SSE stream so the dashboard updates instantly
/// without page refreshes.
model EngineEvent {
  id           String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  brandId      String
  type         EngineEventType
  postId       String?
  mediaAssetId String?
  message      String?
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  brand        Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([brandId, createdAt], map: "idx_engine_event_brand_created")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  CREATOR
  EDITOR
  CLIENT
  VIEWER
}

enum Platform {
  INSTAGRAM
  FACEBOOK
  X
  LINKEDIN
  TIKTOK
}

enum ConnectionStatus {
  CONNECTED
  EXPIRED
}

enum PostStatus {
  DRAFT
  NEEDS_APPROVAL
  SCHEDULED
  PUBLISHED
  FAILED
  REJECTED
}

enum TargetStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum ReplyStatus {
  PENDING
  APPROVED
  REJECTED
  PUBLISHED
}

/// Two states only, per the AMAI Engine product philosophy.
/// ACTIVE   -> engine prepares AND publishes content automatically.
/// PAUSED   -> engine keeps analysing uploads, generating captions/hashtags,
///             and preparing posts, but nothing is published until approved.
enum EngineState {
  ACTIVE
  PAUSED
}

/// Two modes only.
/// MANUAL -> every prepared post goes to the Approval Queue.
/// AUTO   -> prepared posts are scheduled and published automatically
///           at the AI-selected best time, no queue required.
enum ApprovalMode {
  MANUAL
  AUTO
}

enum ContentSource {
  DIRECT_UPLOAD
  GOOGLE_DRIVE
  MANUAL
}

enum EngineEventType {
  MEDIA_UPLOADED
  ANALYSIS_STARTED
  CAPTION_GENERATED
  HASHTAGS_GENERATED
  BEST_TIME_DETERMINED
  APPROVAL_QUEUED
  AUTO_SCHEDULED
  POST_APPROVED
  POST_REJECTED
  POST_EDITED
  PUBLISH_SUCCEEDED
  PUBLISH_FAILED
  ACCOUNT_CONNECTED
  ACCOUNT_DISCONNECTED
  ENGINE_STATE_CHANGED
  APPROVAL_MODE_CHANGED
}
