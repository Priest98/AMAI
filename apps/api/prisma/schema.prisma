generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Schema-changing commands (db push, migrate deploy) need a direct,
  // non-pooled connection — Supabase's transaction-mode pgbouncer pooler
  // (the one DATABASE_URL points at, port 6543) doesn't support the
  // session-level operations these commands issue and just hangs instead
  // of erroring. DIRECT_URL should be the same connection on port 5432
  // (Supabase's "Session" pooler mode, or the true direct db.<ref> host).
  directUrl = env("DIRECT_URL")
}

model User {
  id                         String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  email                      String               @unique
  passwordHash               String
  fullName                   String?
  avatar                     String?
  role                       Role                 @default(OWNER)
  emailVerified              Boolean              @default(false)
  emailVerifiedAt            DateTime?            @db.Timestamptz(6)
  verificationToken          String?              @unique
  verificationTokenExpiresAt DateTime?            @db.Timestamptz(6)
  passwordResetToken         String?              @unique
  passwordResetExpiresAt     DateTime?            @db.Timestamptz(6)
  lastLogin                  DateTime?            @db.Timestamptz(6)
  onboardingCompleted        Boolean              @default(false)
  onboardingSkipped          Boolean              @default(false)
  onboardingCompletedAt      DateTime?            @db.Timestamptz(6)
  createdAt                  DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  memberships                OrganizationMember[]
}

model Organization {
  id           String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  name         String
  slug         String               @unique
  ownerId      String
  createdAt    DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  brands       Brand[]
  members      OrganizationMember[]
  subscription Subscription?
  usageRecords UsageRecord[]
}

enum PlanTier {
  FREE
  PRO
  AGENCY
}

/// Mirrors the payment provider's own subscription lifecycle rather than
/// inventing new states -- so PAST_DUE/CANCELLED/EXPIRED always reflect
/// what Stripe (or whichever provider) actually reports via webhook,
/// never a guess made client-side.
enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  EXPIRED
}

/// One row per Organization -- the billing unit. An Organization can own
/// multiple Brands (see Brand.organizationId), which is exactly the
/// structure Agency needs for multi-client workspaces, so Agency reuses
/// this instead of a parallel "workspace" model. Free organizations get a
/// row here too (plan = FREE, provider = null) created at signup, so
/// "does this org have an active subscription" is never a special case --
/// every organization always has exactly one.
model Subscription {
  id             String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  organizationId String             @unique
  plan           PlanTier           @default(FREE)
  status         SubscriptionStatus @default(ACTIVE)
  // What currency the customer is actually being charged in (USD/GBP/NGN
  // today -- see plans.config.ts SupportedCurrency). Free plan has no
  // charge at all, so this stays at the default until a real checkout
  // happens; set from the Stripe Price object's own currency at webhook
  // time, never guessed at.
  currency       String             @default("USD")
  // Null for Free (no payment provider involved at all).
  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?
  currentPeriodStart     DateTime?  @db.Timestamptz(6)
  currentPeriodEnd       DateTime?  @db.Timestamptz(6)
  // True once the user has requested cancellation but the provider's
  // current billing period hasn't ended yet -- Pro access stays active
  // until currentPeriodEnd, then a webhook flips this to FREE/CANCELLED.
  cancelAtPeriodEnd Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usageRecords UsageRecord[]

  @@index([providerCustomerId], map: "idx_subscription_provider_customer")
  @@index([providerSubscriptionId], map: "idx_subscription_provider_subscription")
}

enum UsageMetric {
  AI_GENERATION
  POST_PUBLISHED
}

/// Metered usage counters, one row per (organization, metric, period).
/// Only for metrics that actually reset on a cadence (AI generations,
/// posts published) -- social-account count and storage are checked live
/// against SocialAccount/MediaAsset instead of tracked here, since those
/// are running totals, not per-period counters.
model UsageRecord {
  id             String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  organizationId String
  subscriptionId String?
  metric         UsageMetric
  periodStart    DateTime  @db.Timestamptz(6)
  periodEnd      DateTime  @db.Timestamptz(6)
  count          Int       @default(0)
  updatedAt      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([organizationId, metric, periodStart])
  @@index([organizationId, metric], map: "idx_usage_record_org_metric")
}

/// Idempotency guard for webhook processing -- payment providers routinely
/// retry webhook deliveries, and double-processing a "payment succeeded"
/// event must never double-extend a billing period or double-fire an
/// analytics event.
model BillingWebhookEvent {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  provider    String
  eventId     String
  type        String
  processedAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([provider, eventId])
}

model OrganizationMember {
  id             String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId         String
  organizationId String
  role           Role         @default(VIEWER)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, organizationId])
  @@index([userId], map: "idx_org_member_user")
  @@index([organizationId], map: "idx_org_member_org")
}

model Brand {
  id                  String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  name                String
  organizationId      String
  logo                String?
  colors              String?
  timezone            String                @default("UTC")
  industry            String?
  createdAt           DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  aiUsageLogs         AiUsageLog[]
  amaiEngineConfig    AmaiEngineConfig?
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  growthSettings      GrowthSettings?
  mediaAssets         MediaAsset[]
  mediaFolders        MediaFolder[]
  PendingCommentReply PendingCommentReply[]
  posts               Post[]
  socialAccounts      SocialAccount[]
  engineEvents        EngineEvent[]
  businessBrain       BusinessBrain?
  memoryEntries       MemoryEntry[]

  @@index([organizationId], map: "idx_brand_org")
}

/// The AMAI "Business Brain" — the persistent business-context store every
/// AI feature (Content Intelligence, Content Strategy, Autopilot 2.0,
/// Recommendation Center) reads before generating anything, instead of
/// generating from a generic "tone" string alone. Explicit fields are what
/// the owner tells AMAI directly (Intelligent Onboarding + Settings).
/// Learned fields are AMAI's own evolving summary, refined over time from
/// performance data and corrections — see MemoryEntry for the granular,
/// timestamped trail behind those learned values.
///
/// One row per Brand, created lazily on first access (see
/// BusinessBrainService.getOrCreate) so existing brands don't need a
/// backfill migration.
model BusinessBrain {
  id      String @id @default(dbgenerated("(gen_random_uuid())::text"))
  brandId String @unique
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // --- Explicit knowledge (owner-provided) ---
  businessDescription String? // what the business does, in the owner's own words
  targetAudience       String? // who they're trying to reach
  brandVoice           String? // e.g. "Playful and bold", "Calm and expert"
  brandPersonality     String[] @default([]) // short tags: "witty", "premium", "no-nonsense"
  contentPillars       String[] @default([]) // recurring themes AMAI should draw content ideas from
  goals                String[] @default([]) // e.g. "Grow followers", "Drive website traffic"
  competitiveContext   String? // who else is in their space / how to differentiate
  avoidTopics          String[] @default([]) // hard "never post about / never say" list
  preferredLanguage    String   @default("en")
  websiteUrl           String?

  // Intelligent Onboarding progress — separate from User.onboardingCompleted
  // (that one is the generic product-tour flag; this tracks completion of
  // the business-context capture flow specifically).
  brainSetupCompleted Boolean @default(false)
  brainSetupStep      Int     @default(0)

  // --- Learned knowledge (AMAI-populated, refined automatically) ---
  learnedInsights Json? // structured, evolving summary AMAI maintains itself (top themes, best-performing angles, etc.)
  lastLearnedAt   DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  memoryEntries MemoryEntry[]
}

enum MemoryEntryType {
  PREFERENCE          // explicit stated preference ("always use emojis", "never post on Sundays")
  CORRECTION          // user edited/rejected AI output in a way that implies a standing rule
  PERFORMANCE_INSIGHT // derived from real post performance data
}

/// Individual, timestamped facts AMAI has learned about a brand — the audit
/// trail behind BusinessBrain.learnedInsights. Kept as its own table (rather
/// than folded into BusinessBrain) so every learned fact carries its own
/// provenance (source post, confidence, when learned) and the AMAI Memory
/// feature can list/expire/dismiss entries individually without touching
/// the rest of the brain.
model MemoryEntry {
  id           String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  brandId      String
  brainId      String
  type         MemoryEntryType
  key          String // short machine-usable label, e.g. "posting_tone"
  value        String // the learned fact/preference, human-readable
  confidence   Float           @default(0.5) // 0-1, raised as evidence accumulates
  sourcePostId String? // the Post this was learned from, if any
  active       Boolean         @default(true) // false = superseded/dismissed, kept for history
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)

  brand Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  brain BusinessBrain @relation(fields: [brainId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([brandId, type], map: "idx_memory_entry_brand_type")
  @@index([brandId, active], map: "idx_memory_entry_brand_active")
}

model GrowthSettings {
  id                String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  brandId           String   @unique
  autoReplyComments Boolean  @default(false)
  commentTone       String   @default("friendly")
  optimizeHashtags  Boolean  @default(true)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  brand             Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model SocialAccount {
  id                String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  brandId           String
  platform          Platform
  platformAccountId String
  accessToken       String
  refreshToken      String?
  tokenExpiresAt    DateTime?        @db.Timestamptz(6)
  metadata          String?
  status            ConnectionStatus @default(CONNECTED)
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  postTargets       PostTarget[]
  brand             Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([platform, platformAccountId])
  @@index([brandId], map: "idx_social_account_brand")
}

model MediaFolder {
  id        String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  brandId   String
  name      String
  parentId  String?
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  assets    MediaAsset[]
  brand     Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parent    MediaFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  MediaFolder[] @relation("FolderHierarchy")

  @@index([brandId], map: "idx_media_folder_brand")
  @@index([parentId], map: "idx_media_folder_parent")
}

enum MediaStatus {
  PENDING // just uploaded, AMAI Engine has not finished analysing/preparing it yet
  PROCESSING // AMAI Engine is analysing content, generating caption/hashtags/best time
  READY // AMAI Engine finished preparing a post from this asset
  SCHEDULED
  PUBLISHED
  FAILED
}

model MediaAsset {
  id               String      @id @default(cuid())
  userId           String?
  brandId          String?
  folderId         String?
  batchId          String?
  batchName        String?
  relativePath     String?
  filename         String
  mimeType         String
  sizeBytes        Int         @default(0)
  blobUrl          String?
  source           ContentSource @default(DIRECT_UPLOAD)
  status           MediaStatus @default(PENDING)
  linkedPostId     String?
  platform         String?
  providerPostId   String?
  publishedAt      DateTime?
  lastErrorMessage String?
  createdAt        DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime    @default(now()) @updatedAt @db.Timestamptz(6)

  brand     Brand?       @relation(fields: [brandId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  folder    MediaFolder? @relation(fields: [folderId], references: [id], onUpdate: NoAction)
  postMedia PostMedia[]
  optimizedVersions OptimizedMediaAsset[]

  @@index([userId])
  @@index([userId, batchId])
  @@index([status])
  @@index([brandId, folderId, createdAt], map: "idx_media_brand_folder_created")
  @@index([brandId, status], map: "idx_media_brand_status")
}

/// One row per (MediaAsset, platform) pair produced by the Media
/// Optimization Engine. The original MediaAsset.blobUrl is never modified —
/// these are always additional, platform-specific derived copies stored
/// alongside it, generated by apps/api/src/media-optimization. Publishing
/// (PublishingService) prefers the row matching its target platform over
/// the raw original when one exists.
model OptimizedMediaAsset {
  id             String     @id @default(cuid())
  mediaAssetId   String
  platform       String     // matches a media-optimization platform-rules config key, e.g. "INSTAGRAM", "TIKTOK" -- intentionally a free string, not the Platform enum, so the optimization layer stays decoupled from the publishing layer's platform list
  kind           String     // "image" | "video"
  blobUrl        String
  width          Int?
  height         Int?
  durationSeconds Float?
  sizeBytes      Int        @default(0)
  format         String     // mime type of the optimized output
  canvasApplied  Boolean    @default(false) // true if blurred-background letterbox/pillarbox padding was used
  croppedApplied Boolean    @default(false) // true if attention/entropy smart-cropping was used instead
  passthrough    Boolean    @default(false) // true if the source couldn't be safely re-processed (e.g. video too large/long for the serverless time budget) and the original was reused as-is
  thumbnailUrl   String?    // video only
  createdAt      DateTime   @default(now()) @db.Timestamptz(6)
  mediaAsset     MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([mediaAssetId, platform])
  @@index([mediaAssetId])
}

/// Persistent health state for the AI Layer's API Key Manager, so a key
/// that was disabled for repeated failures / rate limiting stays disabled
/// across serverless cold starts instead of being retried on every fresh
/// Lambda instance. keyLabel is the env var name (e.g. "GROQ_API_KEY_2"),
/// never the raw key value -- this table never stores secrets.
model AiProviderKeyHealth {
  id                  String    @id @default(cuid())
  provider            String    // "groq" | "gemini" | ...
  keyLabel            String
  consecutiveFailures Int       @default(0)
  totalRequests       Int       @default(0)
  totalErrors         Int       @default(0)
  disabledUntil       DateTime? @db.Timestamptz(6)
  lastUsedAt          DateTime? @db.Timestamptz(6)
  lastErrorMessage    String?
  updatedAt           DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([provider, keyLabel])
}

model Post {
  id               String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  brandId          String
  caption          String
  hashtags         String[]     @default([])
  ctaText          String?
  source           ContentSource @default(MANUAL)
  status           PostStatus   @default(DRAFT)
  scheduledAt      DateTime?    @db.Timestamptz(6)
  optimalScore     Int?
  peakTimeDetected Boolean      @default(false)
  // Lightweight content-type tag (e.g. "video:promotional") set by the AI
  // publishing calendar so the scheduler can avoid placing similar content
  // back-to-back. Nullable: posts created outside that pipeline (manual,
  // legacy) simply don't have one.
  contentCategory  String?
  // Which BusinessBrain.contentPillars entry (if any) this post was matched
  // to by AI Content Intelligence. Nullable: only set once that feature
  // runs; free string rather than a relation so a pillar being renamed or
  // removed later never breaks historical posts.
  contentPillar    String?
  approvedAt       DateTime?    @db.Timestamptz(6)
  rejectedAt       DateTime?    @db.Timestamptz(6)
  publishedAt      DateTime?    @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  brand            Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  media            PostMedia[]
  targets          PostTarget[]

  // Closes a real check-then-write race in SchedulingService.assignNextSlot:
  // it checks isSlotTaken() (a separate count() query) and only later does
  // EngineService actually INSERT the Post -- two concurrent uploads to the
  // same brand (bulk upload, two team members uploading at once) could both
  // see the same instant as free and both book it, double-occupying a
  // configured posting slot / exceeding postsPerDay for that moment. This
  // constraint makes that impossible at the database level; EngineService
  // catches the resulting unique-violation and retries with a fresh slot
  // (see MAX_SLOT_RETRIES there) so a collision degrades to "picked the
  // next available time" instead of two posts silently sharing one.
  //
  // Deliberately NOT filtered by status, unlike isSlotTaken() (which
  // excludes REJECTED posts so a rejected post's old time can be reused).
  // Prisma's stable schema syntax has no way to express a partial/filtered
  // unique index, and this project applies schema changes via `prisma db
  // push` with no migrations directory for hand-written SQL -- adding one
  // here would be new process, not a quick fix. Accepted trade-off: a new
  // post cannot reuse the *exact* instant of a brand's previously-rejected
  // post; EngineService's retry just picks the next slot instead, which is
  // safe and only very marginally less tight calendar packing, not a bug.
  // NULL scheduledAt (drafts) is exempt automatically -- Postgres treats
  // every NULL as distinct in a unique index.
  //
  // Before running `prisma db push` with this change: if any brand already
  // has two non-null-scheduledAt posts colliding on the exact same
  // (brandId, scheduledAt) today (only possible if this exact race already
  // happened in production pre-fix), the push will fail until that
  // duplicate is resolved -- it will not silently drop or corrupt data.
  @@unique([brandId, scheduledAt], map: "uq_post_brand_scheduled_at")
  @@index([brandId, status], map: "idx_post_brand_status")
  @@index([scheduledAt], map: "idx_post_scheduled")
}

model PostTarget {
  id                       String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  postId                   String
  socialAccountId          String
  platform                 Platform
  platformSpecificMetadata String?
  status                   TargetStatus    @default(PENDING)
  // Retry bookkeeping. Attempts were previously derived by COUNTing
  // PublishingLog rows on every failure; storing them makes the retry state
  // readable in one query and lets a stuck in-flight claim be reclaimed
  // safely (see claimedAt).
  attemptCount             Int             @default(0)
  lastAttemptAt            DateTime?       @db.Timestamptz(6)
  // When the current PUBLISHING claim was taken. A claim older than the
  // reclaim window is treated as abandoned (function killed mid-publish),
  // so a post can never be stranded in-flight forever.
  claimedAt                DateTime?       @db.Timestamptz(6)
  post                     Post            @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  socialAccount            SocialAccount   @relation(fields: [socialAccountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  publishingLogs           PublishingLog[]

  @@unique([postId, socialAccountId])
  @@index([socialAccountId], map: "idx_post_target_social_account")
}

model PostMedia {
  postId  String
  assetId String
  asset   MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  post    Post       @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([postId, assetId])
  @@index([assetId], map: "idx_post_media_asset")
}

model AiUsageLog {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  brandId    String
  userId     String
  prompt     String
  completion String
  tokensUsed Int
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([brandId], map: "idx_ai_usage_log_brand")
}

model PublishingLog {
  id           String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  postTargetId String
  status       TargetStatus
  errorMessage String?
  apiResponse  String?
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  postTarget   PostTarget   @relation(fields: [postTargetId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([postTargetId], map: "idx_publishing_log_post_target")
}

/// The AMAI Engine's per-brand configuration: whether it is Active/Paused,
/// which Approval Mode governs publishing, and (optionally) the connected
/// Google Drive sync folder. This replaces the old AutoPilotConfig model.
model AmaiEngineConfig {
  id                 String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  brandId            String              @unique
  state              EngineState         @default(ACTIVE)
  approvalMode       ApprovalMode        @default(MANUAL)
  defaultTone        String              @default("friendly")
  googleRefreshToken String?
  driveFolderId      String?
  webhookToken       String?             @unique
  // Posting Schedule (AI publishing calendar) settings.
  postsPerDay        Int                 @default(1)
  scheduleStartFrom  ScheduleStartOption @default(TODAY)
  customStartDate    DateTime?           @db.Timestamptz(6)
  timeZone           String              @default("UTC")
  schedulingPlatform SchedulingPlatform  @default(BOTH)
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  brand              Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  syncLogs           DriveSyncLog[]
}

/// Centralized, DB-driven platform posting-time configuration for the AI
/// publishing calendar — never hardcoded in application code, so posting
/// windows can be updated or extended to new platforms without a deploy.
/// Seeded with Instagram/TikTok's documented best-time tables; priority 1
/// is the primary recommended time for that day, 2+ are secondary/tertiary
/// fallbacks used once an earlier priority slot is already taken.
model PlatformPostingSlot {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  platform  Platform
  dayOfWeek Int // 0=Sunday .. 6=Saturday (JS Date#getDay convention)
  priority  Int // 1=primary, 2=secondary, 3=tertiary...
  hour      Int // 0-23, local to the brand's configured time zone
  minute    Int // 0-59
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([platform, dayOfWeek, priority])
  @@index([platform, dayOfWeek])
}

model DriveSyncLog {
  id           String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  configId     String
  googleFileId String
  status       TargetStatus
  postId       String?
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  config       AmaiEngineConfig @relation(fields: [configId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([configId, googleFileId])
}

model PendingCommentReply {
  id                  String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  brandId             String
  platform            Platform
  platformAccountId   String
  originalPostId      String
  originalCommentId   String
  originalCommentText String
  aiGeneratedReply    String
  status              ReplyStatus @default(PENDING)
  createdAt           DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  brand               Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([brandId, status], map: "idx_pending_reply_brand_status")
}

/// Append-only audit trail of everything the AMAI Engine does. Powers the
/// real-time activity feed / SSE stream so the dashboard updates instantly
/// without page refreshes.
model EngineEvent {
  id           String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  brandId      String
  type         EngineEventType
  postId       String?
  mediaAssetId String?
  message      String?
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  brand        Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([brandId, createdAt], map: "idx_engine_event_brand_created")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  CREATOR
  EDITOR
  CLIENT
  VIEWER
}

enum Platform {
  INSTAGRAM
  FACEBOOK
  X
  LINKEDIN
  TIKTOK
}

enum ConnectionStatus {
  CONNECTED
  EXPIRED
}

enum PostStatus {
  DRAFT
  NEEDS_APPROVAL
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  REJECTED
}

enum TargetStatus {
  PENDING
  // In-flight. Exists so a publish attempt can be *claimed* atomically:
  // publishOne transitions PENDING -> PUBLISHING with a WHERE guard, and the
  // database guarantees exactly one caller wins. Without a distinct in-flight
  // state, two overlapping cron runs could both read PENDING and both publish
  // the same post to the customer's real account.
  PUBLISHING
  PUBLISHED
  FAILED
}

enum ReplyStatus {
  PENDING
  APPROVED
  REJECTED
  PUBLISHED
}

/// Two states only, per the AMAI Engine product philosophy.
/// ACTIVE   -> engine prepares AND publishes content automatically.
/// PAUSED   -> engine keeps analysing uploads, generating captions/hashtags,
///             and preparing posts, but nothing is published until approved.
enum EngineState {
  ACTIVE
  PAUSED
}

/// Two modes only.
/// MANUAL -> every prepared post goes to the Approval Queue.
/// AUTO   -> prepared posts are scheduled and published automatically
///           at the AI-selected best time, no queue required.
enum ApprovalMode {
  MANUAL
  AUTO
}

enum ContentSource {
  DIRECT_UPLOAD
  GOOGLE_DRIVE
  MANUAL
}

/// When the AI publishing calendar's 7-day schedule window begins.
enum ScheduleStartOption {
  TODAY
  TOMORROW
  CUSTOM
}

/// Which platform(s) the AI publishing calendar optimizes posting times
/// for. BOTH alternates between the Instagram and TikTok best-time tables
/// post-by-post, since a single Post fans out to every connected platform
/// at one shared scheduledAt and can't perfectly match both tables at once.
enum SchedulingPlatform {
  INSTAGRAM
  TIKTOK
  BOTH
}

enum EngineEventType {
  MEDIA_UPLOADED
  ANALYSIS_STARTED
  CAPTION_GENERATED
  HASHTAGS_GENERATED
  BEST_TIME_DETERMINED
  APPROVAL_QUEUED
  AUTO_SCHEDULED
  POST_APPROVED
  POST_REJECTED
  POST_EDITED
  PUBLISH_STARTED
  PUBLISH_UPLOADING
  PUBLISH_SUCCEEDED
  PUBLISH_FAILED
  ACCOUNT_CONNECTED
  ACCOUNT_DISCONNECTED
  ENGINE_STATE_CHANGED
  APPROVAL_MODE_CHANGED
  POSTING_SCHEDULE_UPDATED
}
